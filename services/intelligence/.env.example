# FASALYTICS intelligence service (services/intelligence). SAFE TO COMMIT: placeholders only.
# Copy to `.env` in this directory (or the repo root) for local overrides. `.env` is git-ignored.
# Real process environment variables always take precedence over .env files.
# This service has NO secrets in Milestone 7.

# development | test | production  (production disables /docs and /openapi.json)
APP_ENV=development

# Bind address. 127.0.0.1 keeps the service off your network. This is an INTERNAL service:
# it is reached through the Express gateway, never directly from browsers.
ML_SERVICE_HOST=127.0.0.1
# Project default: 8000. If 8000 is occupied on your machine, override it in your own
# (git-ignored) .env, e.g. ML_SERVICE_PORT=8001, and set ML_SERVICE_URL to match in
# apps/api/.env. Treat such an override as temporary.
ML_SERVICE_PORT=8000

# silent | critical | error | warn | warning | info | debug  (shared name with the Node apps)
LOG_LEVEL=info

# Directory for future model artifacts (relative paths resolve from the repository root).
# It does not need to exist: the service reports "no models loaded" honestly.
ML_MODEL_DIR=./models/artifacts

# Bounded request handling
ML_REQUEST_TIMEOUT_S=30
ML_MAX_BODY_BYTES=1048576
