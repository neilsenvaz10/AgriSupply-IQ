# ---------------------------------------------------------------
# FASALYTICS .gitignore
# Principle: source, config templates and docs are tracked.
# Secrets, datasets, generated data, models and build output are not.
# ---------------------------------------------------------------

# --- Secrets & local environment -------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
service-account*.json
firebase-adminsdk*.json
secrets/

# --- Datasets (raw, processed, scratch) -------------------------
# Original historical CSVs are large and must never be committed.
# The directory itself is kept via .gitkeep; only metadata/docs are tracked.
data/raw/*
!data/raw/.gitkeep
data/processed/
data/interim/
data/external/
data/cache/
data/demo/*.parquet
# Safety net: no CSV/Parquet/archives anywhere unless explicitly force-added.
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.zip
*.7z
*.tar
*.gz
# Docs/fixtures that are intentionally small CSVs must be added with `git add -f`.

# --- Machine-learning artifacts --------------------------------
models/artifacts/
models/checkpoints/
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.ckpt
*.h5
*.xgb
mlruns/

# --- Node / frontend / backend ---------------------------------
node_modules/
dist/
build/
.vite/
.next/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ----------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- Database & Docker local state -----------------------------
pgdata/
*.sqlite
*.sqlite3
docker-compose.override.yml
compose.override.yaml

# --- Logs & temp -----------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp

# --- OS / editor -----------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
