# FASALYTICS PostgreSQL (database/). SAFE TO COMMIT: placeholders only.
#
# Copy to `database/.env` and replace EVERY `change_me_*` value with a long random password.
# `database/.env` is git-ignored. Never commit real credentials.
# This file is intentionally separate from the Express/FastAPI env files. Express connects with the
# application-role DATABASE_URL only (see apps/api/.env.example); it never receives the admin or
# migrator credentials.
#
# Used by:  compose.yaml (container setup), drizzle-kit and the migration runner.

# --- Container (docker compose --env-file database/.env ...) ---------------------------------
# Bootstrap SUPERUSER of the FASALYTICS container. Used only for first-time initialisation and
# administration. Applications and migrations never use it.
POSTGRES_USER=fasalytics_admin
POSTGRES_PASSWORD=change_me_admin_password
POSTGRES_DB=fasalytics

# Host port. The container always listens on 5432 internally. 5433 keeps clear of any other
# PostgreSQL already running on the host's 5432, which this project never touches.
POSTGRES_HOST_PORT=5433

# --- Least-privilege roles created on FIRST initialisation of the data volume ------------------
# migrator: owns the database objects; runs migrations (DDL). Not used at application runtime.
DB_MIGRATOR_USER=fasalytics_migrator
DB_MIGRATOR_PASSWORD=change_me_migrator_password
# app: data access only (SELECT/INSERT/UPDATE/DELETE). Cannot create, alter or drop anything.
DB_APP_USER=fasalytics_app
DB_APP_PASSWORD=change_me_app_password

# ingest (Phase 2.2): the historical importer. SELECT and INSERT only; no DELETE, no DDL. Not created on an
# existing volume automatically: see database/docs/INGESTION.md for the one-time admin command.
DB_INGEST_USER=fasalytics_ingest
DB_INGEST_PASSWORD=change_me_ingest_password

# --- Connection strings (use the SAME passwords as above) ---------------------------------------
# From the HOST (npm scripts, tests, Express/FastAPI running locally): localhost:5433
DATABASE_URL=postgresql://fasalytics_app:change_me_app_password@localhost:5433/fasalytics
DATABASE_MIGRATION_URL=postgresql://fasalytics_migrator:change_me_migrator_password@localhost:5433/fasalytics
# Only for imports into a database you have approved (never the development database without approval):
# DATABASE_INGEST_URL=postgresql://fasalytics_ingest:change_me_ingest_password@localhost:5433/fasalytics

# From ANOTHER CONTAINER on the Compose network (Milestone 9): host `db`, port 5432
#   DATABASE_URL=postgresql://fasalytics_app:change_me_app_password@db:5432/fasalytics
#
# URL-encode special characters in passwords (generated hex passwords need no encoding).
# NOTE: the role passwords are applied only when the volume is first created. Changing them
# here later does NOT change an existing database; see database/README.md ("Resetting").
