# =====================================================================
# FASALYTICS environment template  (SAFE TO COMMIT: placeholders only)
#
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# Variables prefixed VITE_ are bundled into the browser: never put a
# secret in a VITE_* variable.
#
# Port plan: host PostgreSQL on 5432 is the developer's existing
# instance and is NOT used. The FASALYTICS container is published on
# host port 5433 and reached as db:5432 inside the Docker network.
# =====================================================================

# --- Runtime ---------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Frontend (apps/web)  [BROWSER-VISIBLE] --------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME=FASALYTICS

# --- Backend API (apps/api)  [SERVER-ONLY] ---------------------------
API_PORT=4000
# Bind address. 127.0.0.1 keeps the API off your network; use 0.0.0.0 only inside a container.
API_HOST=127.0.0.1
# Exact browser origins (no wildcard, no path). Required explicitly when NODE_ENV=production.
API_CORS_ORIGINS=http://localhost:5173
API_REQUEST_TIMEOUT_MS=15000
# Express -> FastAPI. Inside Docker Compose it is http://intelligence:8000 (set by compose.yaml, not this file)
# Use the loopback IP for the service the Express gateway probes (GET /health).
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=5000

# --- Intelligence service (services/intelligence)  [SERVER-ONLY] -----
# development | test | production
APP_ENV=development
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_PORT=8000
ML_MODEL_DIR=./models/artifacts
ML_REQUEST_TIMEOUT_S=30
ML_MAX_BODY_BYTES=1048576

# --- PostgreSQL  [SERVER-ONLY] ---------------------------------------
# Database credentials and connection strings live in database/.env (git-ignored); see
# database/.env.example and database/README.md. They are deliberately NOT repeated here.
# The Express API does not connect to PostgreSQL until Milestone 10; at that point its
# DATABASE_URL (the least-privilege application role) is added to apps/api/.env.
# Host connections use localhost:5433; containers on the Compose network use db:5432.
# DATABASE_URL=

# --- Data directories (relative to repo root) ------------------------
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# --- Auth: Firebase (planned, not used until later phases) -----------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Public web config values (browser-visible by design):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# --- LLM: Groq (integrated in Phase 8; not used before) --------------
GROQ_API_KEY=
GROQ_MODEL=

# --- External data & services (later phases; leave empty) ------------
DATA_GOV_IN_API_KEY=
WEATHER_API_KEY=
ROUTING_API_KEY=

# --- Messaging (optional, Phase 9; leave empty) ----------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_API_TOKEN=
