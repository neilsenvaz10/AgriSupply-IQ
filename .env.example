# =====================================================================
# FASALYTICS environment template  (SAFE TO COMMIT: placeholders only)
#
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# Variables prefixed VITE_ are bundled into the browser: never put a
# secret in a VITE_* variable.
#
# Port plan: host PostgreSQL on 5432 is the developer's existing
# instance and is NOT used. The FASALYTICS container is published on
# host port 5433 and reached as db:5432 inside the Docker network.
# =====================================================================

# --- Runtime ---------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Frontend (apps/web)  [BROWSER-VISIBLE] --------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME=FASALYTICS

# --- Backend API (apps/api)  [SERVER-ONLY] ---------------------------
API_PORT=4000
API_CORS_ORIGINS=http://localhost:5173
# Express -> FastAPI. Inside Docker Compose use http://ml:8000
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# --- Intelligence service (services/intelligence)  [SERVER-ONLY] -----
ML_SERVICE_PORT=8000
ML_MODEL_DIR=./models/artifacts

# --- PostgreSQL  [SERVER-ONLY] ---------------------------------------
POSTGRES_USER=fasalytics
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=fasalytics
# Host-side port mapping (container always listens on 5432)
POSTGRES_HOST_PORT=5433
# When running Express/ML directly on the host:
DATABASE_URL=postgresql://fasalytics:change_me_local_only@localhost:5433/fasalytics
# When running inside Docker Compose, services use the network name:
# DATABASE_URL=postgresql://fasalytics:change_me_local_only@db:5432/fasalytics

# --- Data directories (relative to repo root) ------------------------
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed

# --- Auth: Firebase (planned, not used until later phases) -----------
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Public web config values (browser-visible by design):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# --- LLM: Groq (integrated in Phase 8; not used before) --------------
GROQ_API_KEY=
GROQ_MODEL=

# --- External data & services (later phases; leave empty) ------------
DATA_GOV_IN_API_KEY=
WEATHER_API_KEY=
ROUTING_API_KEY=

# --- Messaging (optional, Phase 9; leave empty) ----------------------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_API_TOKEN=
