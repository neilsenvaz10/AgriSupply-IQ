# Frontend environment (apps/web). Copy to `.env` for local overrides. `.env` is git-ignored.
# Only variables prefixed VITE_ are bundled into the browser: never put secrets here.

# Base URL of the Express API gateway (never PostgreSQL or the FastAPI service).
# The BROWSER calls this, so it is a host URL even under Docker Compose (never http://api:4000).
VITE_API_BASE_URL=http://localhost:4000

# Request timeout for API calls, in milliseconds (optional).
VITE_API_TIMEOUT_MS=5000
