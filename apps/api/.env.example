# FASALYTICS API environment (apps/api). SAFE TO COMMIT: placeholders only.
# Copy to `.env` (in apps/api or the repo root) for local overrides. `.env` is git-ignored.
# Real process environment variables always take precedence over .env files.
# Never commit real credentials.

NODE_ENV=development

# Network
# Bind address. 127.0.0.1 keeps the API off your network. Use 0.0.0.0 only inside a container.
API_HOST=127.0.0.1
API_PORT=4000

# CORS allowlist: comma-separated ORIGINS (scheme + host + optional port, no path, no wildcard).
# In development the 127.0.0.1 / localhost twin of each loopback origin is also allowed.
# REQUIRED to be set explicitly when NODE_ENV=production.
API_CORS_ORIGINS=http://localhost:5173

# Dependencies (optional: the API starts and reports honestly without them)
# PostgreSQL, as the least-privilege APPLICATION role (fasalytics_app): the API refuses admin,
# migrator and superuser role names. Host processes use localhost:5433; under Docker Compose
# compose.yaml sets it to db:5432 (never localhost:5433 inside a container).
#   postgresql://fasalytics_app:<app password>@localhost:5433/fasalytics
# Real value: copy DATABASE_URL from database/.env into your git-ignored apps/api/.env.
DATABASE_URL=
# Connection pool and probe bounds (all optional). Milliseconds except DB_POOL_MAX.
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=3000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=5000
DB_HEALTH_TIMEOUT_MS=2000
# FastAPI intelligence service base URL, e.g. http://localhost:8000 (probed with GET /health)
# Under Docker Compose this is http://intelligence:8000 (set by compose.yaml; never localhost).
# Project default for host processes: http://127.0.0.1:8000. If that port is occupied locally, override it in your own
# git-ignored .env (for example http://127.0.0.1:8001) and match services/intelligence/.env.
ML_SERVICE_URL=
# Probe timeout for the intelligence service, 100-60000 ms
ML_SERVICE_TIMEOUT_MS=5000

# Per-request timeout for the API itself, 1000-120000 ms
API_REQUEST_TIMEOUT_MS=15000

# silent | error | warn | info | debug
LOG_LEVEL=info
